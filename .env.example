# =====================================================================
# TokenMinGate Enterprise Configuration
# =====================================================================

# Server Port
PORT=8080

# Supabase Cloud Database Configuration
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://eloedezdxtvpkdxebzkc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Real-world LLM Provider API Keys (Optional - offline AI fallback active if unset)
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Redis High-Speed L1 Cache (Included in docker-compose.yml)
REDIS_URL=redis://redis:6379/0

# Gateway Admin Secret (Optional, for locking /admin endpoints)
# GATEWAY_ADMIN_TOKEN=your-admin-secret-token
